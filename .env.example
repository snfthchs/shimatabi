# 実行環境。`production` のときは、シード（デモ用データの投入）を実行できない。
APP_ENV=

# AIプロバイダー。`mock`（ルールベースのモック）または `llm`（LLM API。別Issueで実装）。
AI_PROVIDER="mock"

# 個人情報の暗号化に使う鍵（Fernetの鍵）。Issue B で使う。
# 鍵は次のコマンドで作り、`.env` にだけ書く。この値をコミットしない。
backend/.venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=