# 実行環境。`production` のときは、シード（デモ用データの投入）を実行できない。
APP_ENV=

# AIコンシェルジュ用のAnthropicのAPIキー。設定すると、LLM（Claude）で答える。
# 空のままなら、ルールベースのモックで答える（キーがなくても、AI相談は動く）。
# キーの取得方法は、docs/architecture.md の「LLMのキーの取得と設定」にある。
ANTHROPIC_API_KEY=

# LLMのモデル。空のままなら、claude-haiku-5-5（もっとも安く、速い）。
# 選択肢と値段は、README.md の「AIコンシェルジュの設定」にある。
ANTHROPIC_MODEL=

# 個人情報の暗号化に使う鍵（Fernetの鍵）。Issue B で使う。
# 鍵は次のコマンドで作り、`.env` にだけ書く。この値をコミットしない。
# backend/.venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=